{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "aodadftraining"
		},
		"ls_blobstorage_tpch_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_blobstorage_tpch'"
		},
		"ls_postgresql_tpch_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_postgresql_tpch'"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"ls_postgresql_tpch_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tpch-adf-demo.postgres.database.azure.com"
		},
		"ls_postgresql_tpch_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "mona"
		},
		"ls_postgresql_tpch_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "pgadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "aodadftraining_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_blobstorage_tpch_connectionString": {
						"value": "[parameters('ls_blobstorage_tpch_connectionString')]"
					},
					"ls_postgresql_tpch_password": {
						"value": "[parameters('ls_postgresql_tpch_password')]"
					},
					"HttpServer1_properties_typeProperties_url": {
						"value": "[parameters('HttpServer1_properties_typeProperties_url')]"
					},
					"ls_postgresql_tpch_properties_typeProperties_server": {
						"value": "[parameters('ls_postgresql_tpch_properties_typeProperties_server')]"
					},
					"ls_postgresql_tpch_properties_typeProperties_database": {
						"value": "[parameters('ls_postgresql_tpch_properties_typeProperties_database')]"
					},
					"ls_postgresql_tpch_properties_typeProperties_username": {
						"value": "[parameters('ls_postgresql_tpch_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "aodadftraining_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'aodadftraining_ArmTemplate_0')]"
			]
		}
	]
}